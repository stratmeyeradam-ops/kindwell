<% title = "Subscribe"; include partials/header %>
<section class="page-header">
  <h1>Choose Your Path</h1>
  <p class="page-subtitle">Unlock deeper knowledge, community access, and natural healing resources.</p>
</section>

<div class="container">
  <% if (typeof canceled !== 'undefined' && canceled) { %>
    <div class="info-box">Your subscription was canceled. No charge was made.</div>
  <% } %>

  <div class="pricing-grid">
    <!-- Tier 1: $5 -->
    <div class="pricing-card">
      <h3>Sprout</h3>
      <div class="price"><span class="currency">$</span>5<span class="period">/month</span></div>
      <ul class="pricing-features">
        <li>✅ Access to all introductory remedy guides</li>
        <li>✅ Well-being & stress relief content</li>
        <li>✅ View community board (Level 2)</li>
        <li>✅ Black Hills tradition basics</li>
        <li>🔒 Post to community board</li>
        <li>🔒 Advanced materia medica</li>
      </ul>
      <button class="btn btn-outline" onclick="subscribe(1)">Start with Sprout</button>
    </div>

    <!-- Tier 2: $10 (featured) -->
    <div class="pricing-card featured">
      <span class="badge">Most Popular</span>
      <h3>Grow</h3>
      <div class="price"><span class="currency">$</span>10<span class="period">/month</span></div>
      <ul class="pricing-features">
        <li>✅ Everything in Sprout</li>
        <li>✅ Post to community board</li>
        <li>✅ Advanced remedy guides & dosing</li>
        <li>✅ Stress-remedy matching protocols</li>
        <li>✅ Guided audio exercises</li>
        <li>🔒 Full constitutional assessment tools</li>
      </ul>
      <button class="btn btn-primary" onclick="subscribe(2)">Start with Grow</button>
    </div>

    <!-- Tier 3: $15 -->
    <div class="pricing-card">
      <h3>Flourish</h3>
      <div class="price"><span class="currency">$</span>15<span class="period">/month</span></div>
      <ul class="pricing-features">
        <li>✅ Everything in Grow</li>
        <li>✅ Full community board (all levels, write access)</li>
        <li>✅ Complete materia medica library</li>
        <li>✅ Constitutional assessment tools</li>
        <li>✅ Early access to new content</li>
        <li>✅ Coach waitlist priority notification</li>
      </ul>
      <button class="btn btn-outline" onclick="subscribe(3)">Start with Flourish</button>
    </div>
  </div>

  <section class="prose" style="margin-top: 3rem;">
    <h2>How It Works</h2>
    <ul>
      <li>Create a free account (if you haven't already)</li>
      <li>Choose your tier — you'll be redirected to secure Stripe checkout</li>
      <li>Access unlocks immediately after payment</li>
      <li>Cancel anytime — access continues until end of billing period</li>
    </ul>
    <p class="small">All payments processed securely by Stripe. We never see or store your card details.</p>
  </section>
</div>

<script>
async function subscribe(tier) {
  if (!window.location.origin.includes('localhost') === false && !<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>) {
    window.location.href = '/login?next=/subscribe';
    return;
  }
  
  const btn = event.target;
  btn.textContent = 'Redirecting...';
  btn.disabled = true;
  
  try {
    const res = await fetch('/api/stripe/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tier })
    });
    const data = await res.json();
    
    if (data.url) {
      window.location.href = data.url;
    } else {
      alert(data.error || 'Something went wrong. Please try again.');
      btn.textContent = `Start with $${tier === 1 ? 5 : tier === 2 ? 10 : 15}/month`;
      btn.disabled = false;
    }
  } catch (e) {
    alert('Connection error. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Try Again';
  }
}
</script>

<% include partials/footer %>
