<% title = "My Account" %>
<%- include('partials/header') %>
<section class="page-header">
  <h1>Welcome, <%= user.name %></h1>
  <% if (typeof sub !== 'undefined' && sub === 'success') { %>
    <div class="info-box success">✅ Your subscription is active. Enjoy your new access level!</div>
  <% } %>
</section>

<div class="container">
  <div class="dashboard-grid">
    <!-- Subscription Status -->
    <div class="dash-card">
      <h3>Subscription</h3>
      <% const tierNames = ['Free', 'Sprout ($5)', 'Grow ($10)', 'Flourish ($15)']; %>
      <p class="tier-badge tier-<%= user.subscription_tier %>"><%= tierNames[user.subscription_tier] %></p>
      <% if (user.subscription_tier === 0) { %>
        <p class="dash-hint">You're on the free tier. <a href="/subscribe">Upgrade</a> to unlock more content and community access.</p>
      <% } else { %>
        <p class="dash-hint">Your subscription is active. Manage it via your Stripe billing email or <a href="/contact">contact us</a>.</p>
      <% } %>
    </div>

    <!-- Account Info -->
    <div class="dash-card">
      <h3>Account</h3>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Member since:</strong> <%= new Date(user.created_at).toLocaleDateString() %></p>
      <% if (user.last_login) { %><p><strong>Last login:</strong> <%= new Date(user.last_login).toLocaleString() %></p><% } %>
    </div>

    <!-- Access Level -->
    <div class="dash-card">
      <h3>Your Community Access</h3>
      <% if (user.subscription_tier === 0) { %>
        <p>You can <strong>view</strong> free-level community posts.</p>
      <% } else if (user.subscription_tier === 1) { %>
        <p>You can <strong>view</strong> Level 1–2 posts and <strong>read</strong> the board in depth.</p>
      <% } else if (user.subscription_tier === 2) { %>
        <p>You can <strong>view</strong> all posts, <strong>post</strong> new topics, and <strong>reply</strong> to existing threads.</p>
      <% } else { %>
        <p>Full access — you can <strong>view, post, and reply</strong> across all community levels. You're a full member of the Kindwell circle.</p>
      <% } %>
      <a href="/board" class="btn btn-primary btn-sm" style="margin-top:1rem;">Visit Community Board</a>
    </div>

    <!-- Login History -->
    <div class="dash-card">
      <h3>Recent Logins</h3>
      <table class="login-table">
        <thead><tr><th>Date</th><th>IP Address</th><th>Status</th></tr></thead>
        <tbody>
          <% recentLogins.forEach(function(e) { %>
            <tr>
              <td><%= new Date(e.created_at).toLocaleString() %></td>
              <td><%= e.ip_address || '—' %></td>
              <td><% if (e.success) { %><span class="badge-success">Success</span><% } else { %><span class="badge-error">Failed</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
