<% title = "Community Board"; include partials/header %>
<section class="page-header">
  <h1>Community Board</h1>
  <p class="page-subtitle">Share experiences, ask questions, and grow together.</p>
</section>

<div class="container">
  <!-- Tier info -->
  <div class="board-tier-info tier-<%= tier %>">
    <% if (tier === 0) { %>
      <p>👁️ You're viewing the <strong>free level</strong>. <a href="/subscribe">Subscribe</a> to post and access deeper conversations.</p>
    <% } else if (tier === 1) { %>
      <p>🌱 You're on <strong>Sprout</strong> — you can view Levels 1–2. Upgrade to post or reply.</p>
    <% } else if (tier === 2) { %>
      <p>🌿 You're on <strong>Grow</strong> — you can view all levels, post new topics, and reply.</p>
    <% } else { %>
      <p>🌳 You're on <strong>Flourish</strong> — full access to everything. Welcome to the inner circle.</p>
    <% } %>
  </div>

  <!-- New Post (if allowed) -->
  <% if (canPost) { %>
    <div class="new-post-box">
      <h3>Start a New Topic</h3>
      <form method="POST" action="/board/post">
        <div class="form-group">
          <input type="text" name="title" required placeholder="Topic title" maxlength="120" />
        </div>
        <div class="form-group">
          <textarea name="body" required rows="4" placeholder="Share your experience or ask a question..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Post to Board</button>
      </form>
    </div>
  <% } %>

  <!-- Messages List -->
  <div class="messages-list">
    <% if (messages.length === 0) { %>
      <div class="empty-state">
        <p>No posts yet at your access level. Be the first to start a conversation!</p>
      </div>
    <% } %>
    
    <% messages.forEach(function(msg) { %>
      <div class="message-item tier-badge-sm tier-<%= msg.tier_level - 1 %>">
        <div class="msg-header">
          <a href="/board/<%= msg.id %>" class="msg-title"><%= msg.title %></a>
          <span class="msg-meta">by <%= msg.author %> · <%= new Date(msg.created_at).toLocaleDateString() %> · <%= msg.reply_count %> replies</span>
        </div>
        <% if (msg.tier_level > 1 && tier === 0) { %>
          <p class="msg-preview locked-preview">🔒 This post is at a higher tier level. Subscribe to read the full conversation.</p>
        <% } else { %>
          <p class="msg-preview"><%= msg.body.substring(0, 150) %><% if (msg.body.length > 150) { %>...<% } %></p>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>

<% include partials/footer %>
